{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wvd.local/schemas/author-workflow.schema.json",
  "title": "WVD author workflow",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "flow", "entry", "nodes", "edges", "layout", "execution"],
  "properties": {
    "schema": { "const": 1 },
    "interface": { "$ref": "#/$defs/publicInterface" },
    "revision": { "$ref": "#/$defs/revision" },
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "description": { "type": "string", "maxLength": 2048 }
      }
    },
    "entry": { "$ref": "#/$defs/id" },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/edge" }
    },
    "layout": { "$ref": "#/$defs/layout" },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["time_limit_ms"],
      "properties": {
        "time_limit_ms": { "type": "integer", "minimum": 1, "maximum": 1800000 },
        "resource_locale": { "enum": ["", "en", "zh-Hant", "zh-Hans", "ja"] },
        "events": { "type": "object", "maxProperties": 32, "propertyNames": { "$ref": "#/$defs/id" }, "additionalProperties": { "$ref": "#/$defs/eventRule" } }
      }
    }
  },
  "$defs": {
    "eventResume": { "oneOf": [
      { "type": "object", "additionalProperties": false, "required": ["mode"], "properties": { "mode": { "const": "reobserve" } } },
      { "type": "object", "additionalProperties": false, "required": ["mode", "node_id", "guard"], "properties": { "mode": { "const": "replan" }, "node_id": { "$ref": "#/$defs/id" }, "guard": { "$ref": "#/$defs/condition" } } }
    ] },
    "eventRule": { "type": "object", "additionalProperties": false, "required": ["enabled", "class", "priority", "detect"], "properties": {
      "enabled": { "type": "boolean" }, "class": { "enum": ["overlay", "encounter"] },
      "priority": { "type": "integer", "minimum": 0, "maximum": 1000 }, "detect": { "$ref": "#/$defs/condition" },
      "handler": { "$ref": "#/$defs/flowCall" }, "resume": { "$ref": "#/$defs/eventResume" },
      "allow_nested": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
      "disposition": { "enum": ["handled", "external_blocked"] }, "reason": { "type": "string", "minLength": 1, "maxLength": 256 }
    } },
    "eventOverrides": { "type": "object", "maxProperties": 32, "propertyNames": { "$ref": "#/$defs/id" }, "additionalProperties": {
      "type": "object", "additionalProperties": false, "minProperties": 1, "properties": { "enabled": { "type": "boolean" }, "arguments": { "type": "object", "maxProperties": 64, "additionalProperties": { "type": ["boolean", "number", "string"] } } }
    } },
    "eventResumes": { "type": "object", "maxProperties": 32, "propertyNames": { "$ref": "#/$defs/id" }, "additionalProperties": { "$ref": "#/$defs/eventResume" } },
    "publicInterface": {"type": "object", "additionalProperties": false, "required": [], "properties": {"kind": {"enum": ["step", "block", "task"]}, "category": {"type": "string", "maxLength": 128}, "parameters": {"type": "array", "maxItems": 64, "items": {"type": "object", "additionalProperties": false, "required": ["name", "type", "default", "bindings"], "properties": {"name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$", "maxLength": 160}, "label": {"type": "string"}, "type": {"enum": ["boolean", "integer", "number", "string", "resource"]}, "default": {"type": ["boolean", "number", "string"]}, "min": {"type": "number"}, "max": {"type": "number"}, "max_length": {"type": "integer", "minimum": 1, "maximum": 4096}, "choices": {"type": "array", "minItems": 1, "items": {"type": ["boolean", "number", "string"]}}, "bindings": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["node", "path"], "properties": {"node": {"$ref": "#/$defs/id"}, "path": {"type": "string", "pattern": "^/", "maxLength": 512}}}}}}}}},
    "flowCall": {"type": "object", "additionalProperties": false, "required": ["flow_id"], "properties": {"flow_id": {"$ref": "#/$defs/id"}, "arguments": {"type": "object", "maxProperties": 64, "additionalProperties": {"type": ["boolean", "number", "string"]}}, "expected_revision": {"$ref": "#/$defs/revision"}, "extensions": {"type": "object", "maxProperties": 32, "additionalProperties": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/flowCall"}}}}},
    "callNode": {"type": "object", "additionalProperties": false, "required": ["id", "type", "name", "parameters"], "properties": {"id": {"$ref": "#/$defs/id"}, "name": {"type": "string", "minLength": 1, "maxLength": 128}, "type": {"const": "call"}, "repeat_limit": {"type": "integer", "minimum": 1, "maximum": 256}, "event_overrides": { "$ref": "#/$defs/eventOverrides" }, "resume": { "$ref": "#/$defs/eventResumes" }, "parameters": {"$ref": "#/$defs/flowCall"}}},
    "slotNode": {"type": "object", "additionalProperties": false, "required": ["id", "type", "name", "parameters"], "properties": {"id": {"$ref": "#/$defs/id"}, "name": {"type": "string", "minLength": 1, "maxLength": 128}, "type": {"const": "slot"}, "repeat_limit": {"type": "integer", "minimum": 1, "maximum": 256}, "event_overrides": { "$ref": "#/$defs/eventOverrides" }, "resume": { "$ref": "#/$defs/eventResumes" }, "parameters": {"type": "object", "additionalProperties": false, "required": ["name"], "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 160}, "calls": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/flowCall"}}}}}},
    "routeNode": {"type": "object", "additionalProperties": false, "required": ["id", "type", "name", "parameters"], "properties": {"id": {"$ref": "#/$defs/id"}, "name": {"type": "string", "minLength": 1, "maxLength": 128}, "type": {"const": "route"}, "repeat_limit": {"type": "integer", "minimum": 1, "maximum": 256}, "event_overrides": { "$ref": "#/$defs/eventOverrides" }, "resume": { "$ref": "#/$defs/eventResumes" }, "parameters": {"type": "object", "additionalProperties": false, "required": [], "properties": {}}}},
    "semanticCondition": {"type": "object", "additionalProperties": false, "required": ["mode", "id"], "properties": {"mode": {"const": "semantic"}, "id": {"type": "string", "minLength": 1, "maxLength": 160}}},
    "locationCondition": {"type": "object", "additionalProperties": false, "required": ["mode", "id"], "properties": {"mode": {"const": "location"}, "id": {"type": "integer", "minimum": 0, "maximum": 65535}}},
    "brightCondition": {"type": "object", "additionalProperties": false, "required": ["mode", "image"], "properties": {"mode": {"const": "bright_mask"}, "image": {"type": "string", "minLength": 1, "maxLength": 160}, "roi": {"$ref": "#/$defs/roi"}, "threshold": {"type": "number", "minimum": 0, "maximum": 1}, "min_brightness": {"type": "integer", "minimum": 0, "maximum": 255}}},
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "roi": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        { "type": "integer", "minimum": 0, "maximum": 899 },
        { "type": "integer", "minimum": 0, "maximum": 1599 },
        { "type": "integer", "minimum": 1, "maximum": 900 },
        { "type": "integer", "minimum": 1, "maximum": 1600 }
      ]
    },
    "point": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        { "type": "integer", "minimum": 1, "maximum": 898 },
        { "type": "integer", "minimum": 1, "maximum": 1598 }
      ]
    },
    "templateCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "image"],
      "properties": {
        "mode": { "const": "template" },
        "image": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^(?!/)(?!.*(?:\\.\\.|:|\\\\)).+$"
        },
        "threshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "roi": { "$ref": "#/$defs/roi" },
        "grayscale": { "type": "boolean" }
      }
    },
    "ocrCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "expected"],
      "properties": {
        "mode": { "const": "ocr" },
        "expected": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        },
        "roi": { "$ref": "#/$defs/roi" }
      }
    },
    "compositeCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "conditions"],
      "properties": {
        "mode": { "enum": ["all", "any"] },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/condition" }
        }
      }
    },
    "notCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "conditions"],
      "properties": {
        "mode": { "const": "not" },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "$ref": "#/$defs/condition" }
        }
      }
    },
    "builtinCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {
          "enum": [
            "auto_route_moving", "auto_route_post", "blocking_screen", "boot_post",
            "boot_ready", "combat_active", "dark_light_clear", "dark_light_post",
            "default_dialogue", "dialogue_post", "fast_forward_off", "fishing_bait_empty",
            "fishing_reward", "fishing_unknown", "map_route_post", "mining_reward",
            "movement_stopped", "next_low_confidence", "party_death", "party_defeat",
            "pause", "pause_negative", "special_dialogue", "special_dialogue_post",
            "target_marker", "task_stop"
          ]
        }
      }
    },
    "condition": {
      "oneOf": [
        { "$ref": "#/$defs/templateCondition" },
        { "$ref": "#/$defs/semanticCondition" },
        { "$ref": "#/$defs/locationCondition" },
        { "$ref": "#/$defs/brightCondition" },
        { "$ref": "#/$defs/ocrCondition" },
        { "$ref": "#/$defs/compositeCondition" },
        { "$ref": "#/$defs/notCondition" },
        { "$ref": "#/$defs/builtinCondition" }
      ]
    },
    "nodeBase": {
      "type": "object",
      "required": ["id", "type", "name", "parameters"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["recognition", "action", "wait", "business", "end", "call", "slot", "route"] },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "repeat_limit": { "type": "integer", "minimum": 1, "maximum": 256 }, "event_overrides": { "$ref": "#/$defs/eventOverrides" }, "resume": { "$ref": "#/$defs/eventResumes" }
      }
    },
    "recognitionNode": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "name", "parameters"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "type": { "const": "recognition" },
            "name": { "type": "string", "minLength": 1, "maxLength": 128 },
            "repeat_limit": { "type": "integer", "minimum": 1, "maximum": 256 }, "event_overrides": { "$ref": "#/$defs/eventOverrides" }, "resume": { "$ref": "#/$defs/eventResumes" },
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "required": ["condition"],
              "properties": {
                "condition": { "$ref": "#/$defs/condition" },
                "delay_after_ms": { "type": "integer", "minimum": 0, "maximum": 10000 }
              }
            }
          }
        }
      ]
    },
    "clickParameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "scene", "target", "postcondition"],
      "properties": {
        "operation": { "const": "click" },
        "scene": { "$ref": "#/$defs/condition" },
        "target": { "$ref": "#/$defs/condition" },
        "postcondition": { "$ref": "#/$defs/condition" },
        "offset": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            { "type": "integer", "minimum": -900, "maximum": 900 },
            { "type": "integer", "minimum": -1600, "maximum": 1600 }
          ]
        },
        "allowed_area": { "$ref": "#/$defs/roi" },
        "postcondition_timeout_ms": { "type": "integer", "minimum": 1, "maximum": 60000 },
        "delay_after_ms": { "type": "integer", "minimum": 0, "maximum": 10000 }
      }
    },
    "fixedClickParameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "scene", "postcondition", "position"],
      "properties": {
        "operation": { "const": "fixed_click" },
        "scene": { "$ref": "#/$defs/condition" },
        "postcondition": { "$ref": "#/$defs/condition" },
        "position": { "$ref": "#/$defs/point" },
        "allowed_area": { "$ref": "#/$defs/roi" },
        "postcondition_timeout_ms": { "type": "integer", "minimum": 1, "maximum": 60000 },
        "delay_after_ms": { "type": "integer", "minimum": 0, "maximum": 10000 }
      }
    },
    "backParameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "scene", "postcondition"],
      "properties": {
        "operation": { "const": "back" },
        "scene": { "$ref": "#/$defs/condition" },
        "postcondition": { "$ref": "#/$defs/condition" },
        "allowed_area": { "$ref": "#/$defs/roi" },
        "postcondition_timeout_ms": { "type": "integer", "minimum": 1, "maximum": 60000 },
        "delay_after_ms": { "type": "integer", "minimum": 0, "maximum": 10000 }
      }
    },
    "swipeParameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "scene", "postcondition", "coordinates", "duration_ms"],
      "properties": {
        "operation": { "const": "swipe" },
        "scene": { "$ref": "#/$defs/condition" },
        "postcondition": { "$ref": "#/$defs/condition" },
        "coordinates": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            { "type": "integer", "minimum": 1, "maximum": 898 },
            { "type": "integer", "minimum": 1, "maximum": 1598 },
            { "type": "integer", "minimum": 1, "maximum": 898 },
            { "type": "integer", "minimum": 1, "maximum": 1598 }
          ]
        },
        "duration_ms": { "type": "integer", "minimum": 1, "maximum": 60000 },
        "allowed_area": { "$ref": "#/$defs/roi" },
        "postcondition_timeout_ms": { "type": "integer", "minimum": 1, "maximum": 60000 },
        "delay_after_ms": { "type": "integer", "minimum": 0, "maximum": 10000 }
      }
    },
    "actionNode": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "name", "parameters"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "type": { "const": "action" },
            "name": { "type": "string", "minLength": 1, "maxLength": 128 },
            "repeat_limit": { "type": "integer", "minimum": 1, "maximum": 256 }, "event_overrides": { "$ref": "#/$defs/eventOverrides" }, "resume": { "$ref": "#/$defs/eventResumes" },
            "parameters": {
              "oneOf": [
                { "$ref": "#/$defs/clickParameters" },
                { "$ref": "#/$defs/fixedClickParameters" },
                { "$ref": "#/$defs/backParameters" },
                { "$ref": "#/$defs/swipeParameters" }
              ]
            }
          }
        }
      ]
    },
    "waitNode": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "name", "parameters"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "type": { "const": "wait" },
            "name": { "type": "string", "minLength": 1, "maxLength": 128 },
            "repeat_limit": { "type": "integer", "minimum": 1, "maximum": 256 }, "event_overrides": { "$ref": "#/$defs/eventOverrides" }, "resume": { "$ref": "#/$defs/eventResumes" },
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "required": ["duration_ms"],
              "properties": {
                "duration_ms": { "type": "integer", "minimum": 1, "maximum": 10000 }
              }
            }
          }
        }
      ]
    },
    "confirmParameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding", "operation_id", "event", "condition"],
      "properties": {
        "binding": { "const": "confirm" },
        "operation_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "event": { "type": "string", "minLength": 1, "maxLength": 96 },
        "condition": { "$ref": "#/$defs/condition" },
        "expected_step": { "type": "integer", "minimum": 0, "maximum": 4096 },
        "delay_after_ms": { "type": "integer", "minimum": 0, "maximum": 10000 }
      }
    },
    "combatParameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding", "condition", "arguments"],
      "properties": {
        "binding": { "const": "combat" },
        "condition": { "$ref": "#/$defs/condition" },
        "arguments": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["operation", "portraits", "catalog"],
              "properties": {
                "operation": { "const": "prepare" },
                "portraits": {
                  "type": "array",
                  "maxItems": 128,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["image", "role"],
                    "properties": {
                      "image": { "type": "string", "minLength": 1, "maxLength": 160 },
                      "role": { "type": "string", "minLength": 1, "maxLength": 128 }
                    }
                  }
                },
                "catalog": { "type": "array", "maxItems": 128 }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["operation", "index"],
              "properties": {
                "operation": { "enum": ["success", "auto_confirmed"] },
                "index": { "type": "integer", "minimum": 0, "maximum": 127 }
              }
            }
          ]
        },
        "delay_after_ms": { "type": "integer", "minimum": 0, "maximum": 10000 }
      }
    },
    "chestParameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding", "condition", "preferred", "seed"],
      "properties": {
        "binding": { "const": "chest" },
        "condition": { "$ref": "#/$defs/condition" },
        "preferred": { "type": "integer", "minimum": 0, "maximum": 6 },
        "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "delay_after_ms": { "type": "integer", "minimum": 0, "maximum": 10000 }
      }
    },
    "taskStageParameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding", "task_id", "stage"],
      "properties": {
        "binding": { "const": "task_stage" },
        "task_id": { "$ref": "#/$defs/id" },
        "stage": { "enum": ["prepare", "enter", "traverse"] }
      }
    },
    "businessNode": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "name", "parameters"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "type": { "const": "business" },
            "name": { "type": "string", "minLength": 1, "maxLength": 128 },
            "repeat_limit": { "type": "integer", "minimum": 1, "maximum": 256 }, "event_overrides": { "$ref": "#/$defs/eventOverrides" }, "resume": { "$ref": "#/$defs/eventResumes" },
            "parameters": {
              "oneOf": [
                { "$ref": "#/$defs/confirmParameters" },
                { "$ref": "#/$defs/combatParameters" },
                { "$ref": "#/$defs/chestParameters" },
                { "$ref": "#/$defs/taskStageParameters" }
              ]
            }
          }
        }
      ]
    },
    "endNode": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "name", "parameters"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "type": { "const": "end" },
            "name": { "type": "string", "minLength": 1, "maxLength": 128 },
            "repeat_limit": { "type": "integer", "minimum": 1, "maximum": 256 }, "event_overrides": { "$ref": "#/$defs/eventOverrides" }, "resume": { "$ref": "#/$defs/eventResumes" },
            "parameters": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["outcome"],
                  "properties": { "outcome": { "const": "success" } }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["outcome", "reason"],
                  "properties": {
                    "outcome": { "const": "failure" },
                    "reason": { "type": "string", "minLength": 1, "maxLength": 256 }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "node": {
      "oneOf": [
        { "$ref": "#/$defs/recognitionNode" },
        { "$ref": "#/$defs/actionNode" },
        { "$ref": "#/$defs/waitNode" },
        { "$ref": "#/$defs/businessNode" },
        { "$ref": "#/$defs/endNode" },
        { "$ref": "#/$defs/callNode" },
        { "$ref": "#/$defs/slotNode" },
        { "$ref": "#/$defs/routeNode" }
      ]
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to", "outcome", "order"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "from": { "$ref": "#/$defs/id" },
        "to": { "$ref": "#/$defs/id" },
        "outcome": { "enum": ["success", "failure"] },
        "order": { "type": "integer", "minimum": 0, "maximum": 4095 }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes", "viewport"],
      "properties": {
        "nodes": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["node_id", "x", "y"],
            "properties": {
              "node_id": { "$ref": "#/$defs/id" },
              "x": { "type": "number", "minimum": -1000000, "maximum": 1000000 },
              "y": { "type": "number", "minimum": -1000000, "maximum": 1000000 }
            }
          }
        },
        "viewport": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "zoom"],
          "properties": {
            "x": { "type": "number", "minimum": -1000000, "maximum": 1000000 },
            "y": { "type": "number", "minimum": -1000000, "maximum": 1000000 },
            "zoom": { "type": "number", "minimum": 0.05, "maximum": 8 }
          }
        }
      }
    }
  }
}
